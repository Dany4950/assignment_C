rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomCode} {

      // Signed-in users can read rooms.
      allow read: if request.auth != null;

      // A signed-in user can create a room.
      allow create: if request.auth != null;

      // Allow the member count to be updated by signed-in users.
      allow update: if request.auth != null;

      // Rooms cannot be deleted from the app.
      allow delete: if false;

      // Room members
      match /members/{memberId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null;

        // Don't allow changing or deleting membership records.
        allow update, delete: if false;
      }

      // Chat messages
      match /messages/{messageId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null;

        // Messages cannot be edited or deleted.
        allow update, delete: if false;
      }
    }
  }
}